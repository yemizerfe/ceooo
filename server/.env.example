# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceooo?schema=public"

# Server
PORT=5010
# ---- Platform administrator (no credentials are ever committed) ----
# The account is created/promoted on boot. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Set to "true" to overwrite an existing administrator password on boot.
ADMIN_RESET_PASSWORD=false
# JSON logs in production; debug|info|warn|error
LOG_LEVEL=info
# Where uploaded files are written inside the container
UPLOADS_DIR=./uploads
# Max request body size accepted by the API
BODY_LIMIT=10mb
# Number of trusted reverse-proxy hops (1 behind an ingress/load balancer,
# 0 when the process is exposed directly)
TRUST_PROXY_HOPS=1
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5010"

# Security / Auth
JWT_SECRET="replace-with-long-random-secret-string"
SESSION_SECRET="replace-with-another-long-random-secret-string"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5010/api/auth/google/callback"

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5010/api/auth/github/callback"

# Gemini AI
AI_PROVIDER="google-gemini"
GOOGLE_API_KEY=""
# Alternatively, use GEMINI_API_KEY or AI_API_KEY.
GEMINI_MODEL="gemini-2.5-flash"
AI_TIMEOUT="60000"
AI_MAX_RETRIES="3"
AI_CACHE_TTL="300"
AI_ENABLE_ANALYTICS="false"

# SMTP / Password Reset (optional - without these, reset links are logged to console in dev)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@ceooo.local"

# Optional Redis / BullMQ (not required for basic operation)
REDIS_URL=""

# Admin master password (used for CLI / first-user flows; optional)
ADMIN_PASSWORD_RESET=""

# ════════════════════════════════════════════════════════════════════════════
# Integrations
# ════════════════════════════════════════════════════════════════════════════
# Every platform except Airtable connects the same way: clicking Connect sends
# the browser to that vendor's own “allow access to this app?” screen, and the
# vendor redirects back to /dashboard/integrations when the user approves.
#
# For each one: create an OAuth app in the vendor's developer console, paste its
# client id/secret here, and register the callback URL shown next to it
# (callback paths are /api/integrations/<provider>/callback, or the provider's
# *_REDIRECT_URI value when one is set). Anything left blank shows an
# actionable message on the integrations page instead of a broken redirect.
#
# Local development base: http://localhost:5010
# Production: use the public HTTPS API origin instead, e.g.
#   https://api.example.com/api/integrations/hubspot/callback

# HubSpot
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:5010/api/integrations/hubspot/callback"

# Salesforce — must match the Connected App callback URL exactly
# (Setup → App Manager → your app → Manage Consumer Details). The authorization
# request is sent with PKCE (S256), which Connected Apps now require.
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_REDIRECT_URI="http://localhost:5010/api/integrations/salesforce/callback"

# Zoho CRM — the authorised Zoho user must have the CRM module enabled.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:5010/api/integrations/zoho/callback"

# Jira (Atlassian 3LO). The Jira site cloudId is discovered during the callback.
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
JIRA_REDIRECT_URI="http://localhost:5010/api/integrations/jira/callback"

# Asana
ASANA_CLIENT_ID=""
ASANA_CLIENT_SECRET=""
ASANA_REDIRECT_URI="http://localhost:5010/api/integrations/asana/callback"

# Monday.com
MONDAY_CLIENT_ID=""
MONDAY_CLIENT_SECRET=""
MONDAY_REDIRECT_URI="http://localhost:5010/api/integrations/monday/callback"

# Notion — public integration; token endpoint needs HTTP Basic client auth.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:5010/api/integrations/notion/callback"

# Slack
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5010/api/integrations/slack/callback"

# QuickBooks — the company (realm) id arrives with the callback and is stored.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:5010/api/integrations/quickbooks/callback"

# Stripe Connect — STRIPE_CLIENT_ID is the `ca_...` Connect client id from
# Dashboard → Connect → OAuth settings; STRIPE_SECRET_KEY is the platform secret
# key used for the token exchange. A publishable key (pk_...) is not a Connect
# client id and cannot start this flow. When STRIPE_CLIENT_ID is absent the
# integration still works read-only through STRIPE_SECRET_KEY.
STRIPE_CLIENT_ID=""
STRIPE_SECRET_KEY=""
STRIPE_REDIRECT_URI="http://localhost:5010/api/integrations/stripe/callback"

# Trello — OAuth 1.0a. TRELLO_CLIENT_ID is the Power-Up “API key” and
# TRELLO_CLIENT_SECRET is its secret (trello.com/power-ups/admin → API Key).
# Trello answers “App not found” when the key does not belong to an existing app;
# regenerate the pair there (or at trello.com/app-key) if that happens. A key +
# token from trello.com/app-key also works: set them here (shared) or let each
# user paste their own pair on the integrations card.
# TRELLO_API_KEY=""
# TRELLO_TOKEN=""
TRELLO_CLIENT_ID=""
TRELLO_CLIENT_SECRET=""
TRELLO_REDIRECT_URI="http://localhost:5010/api/integrations/trello/callback"

# GitHub — register this callback URL on the GitHub OAuth app.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:5010/api/integrations/github/callback"

# Google Sheets / Drive / Calendar — one Google OAuth client per row, and each
# client must list GOOGLE_CALLBACK_URL as an authorised redirect URI. The server
# dispatches the shared callback to the right provider using the signed state.
GOOGLE_CALLBACK_URL="http://localhost:5010/api/auth/google/callback"
GOOGLE_SHEETS_CLIENT_ID=""
GOOGLE_SHEETS_CLIENT_SECRET=""
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Dropbox
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""
DROPBOX_REDIRECT_URI="http://localhost:5010/api/integrations/dropbox/callback"

# Airtable is the one platform without a consent screen: it uses a personal
# access token (airtable.com/create/tokens). Set it here to enable the shared
# server token, or let users paste their own PAT on the integrations page.
AIRTABLE_ACCESS_TOKEN=""

# Optional per-provider scope override for OAuth 2.0, e.g. for a vendor console
# where only a subset is enabled: HUBSPOT_SCOPES="crm.objects.contacts.read"
